{
  "name": "batra-connect-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run check",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "create-staff": "node --env-file-if-exists=.env scripts/create-staff.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "jobs:once": "node --env-file-if-exists=.env scripts/run-jobs.js",
    "test": "node --env-file-if-exists=.env.test --test tests/*.test.js",
    "check": "for f in src/*.js src/routes/*.js scripts/*.js; do node --check \"$f\" || exit 1; done",
    "backup:verify": "sh scripts/restore-check.sh",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests",
    "lint": "eslint src scripts tests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10"
  }
}
