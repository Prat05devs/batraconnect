{
  "expo": {
    "name": "Batra Connect",
    "slug": "batra-connect",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.batraconnect.app",
      "appleTeamId": "9Q56J23Z23",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your position is attached to a report only when you tap \"Use my current location\", so the field officer can find the exact place."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.batraconnect.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "batra-connect",
    "plugins": [
      "./plugins/with-quoted-bundle-script",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your Batra Connect report.",
          "cameraPermission": "Take a photo of the issue, or of completed work, for a Batra Connect report.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your position is attached to a report only when you tap \"Use my current location\", so the field officer can find the exact place.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#075BD8",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e82a32a9-fee0-436f-8600-151525ca36a9"
      }
    },
    "owner": "wtsolutions5"
  }
}
