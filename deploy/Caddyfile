# Automatic HTTPS (Let's Encrypt) for the API. Point the DNS A/AAAA record for API_DOMAIN at this host first.
{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:4000 {
		health_uri /health/ready
	}
}
