NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# PostgreSQL is required locally and in deployment.
DATABASE_URL=postgresql://batra:replace-me@127.0.0.1:5433/batra_connect
# Supabase (production): use the Session pooler string (IPv4) from Connect, plus TLS with Supabase's CA certificate:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
DATABASE_POOL_SIZE=10              # Supabase's smallest plan allows about 15 pooled connections; use 5 there
DB_PASSWORD=replace-me
CORS_ORIGINS=http://localhost:8081,http://localhost:8092,http://127.0.0.1:8082,http://localhost:5173
SESSION_DAYS=7
# Set only to the exact number of trusted reverse-proxy hops when deployed (1 behind the bundled Caddy).
TRUST_PROXY_HOPS=0

# Encrypts provider keys saved from the web dashboard (Integrations). Required in production, 32+ random characters.
# Keep a copy safe: if it is lost, keys saved in the dashboard must be entered again.
CONFIG_MASTER_KEY=

# --- Policy ---
REQUIRE_VERIFIED_CONTACT=true      # citizens verify email or mobile before sending reports, ideas, bookings
REQUIRE_CLOSURE_EVIDENCE=true      # a photo is required to mark a report resolved
CLOSED_REPORT_RETENTION_DAYS=0     # 0 keeps closed reports; otherwise redact details/photos after N days
RUN_JOBS=true                      # delivery, escalation, reminders and cleanup
JOB_INTERVAL_SECONDS=60

# --- Media: filesystem by default; set S3_BUCKET for any S3-compatible store (Supabase Storage, AWS, Cloudflare R2) ---
# Supabase Storage: create a PRIVATE bucket, generate S3 access keys under Storage settings, then
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3  S3_REGION=<project region, e.g. ap-south-1>  S3_FORCE_PATH_STYLE=true
MEDIA_DIR=./data/media
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Delivery. Without providers, development logs messages (including codes) to the console. ---
SMTP_URL=                          # optional: can be set from the web dashboard instead (Integrations)
EMAIL_FROM=Batra Connect <no-reply@batraconnect.com>
EXPO_ACCESS_TOKEN=                 # optional; enable "enhanced push security" in Expo and set it here
SMS_PROVIDER=                      # twilio, or empty to disable SMS. Indian SMS also needs DLT template registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
DELIVERY_ALLOW_LOG=                # development only: false stops printing messages to the console (never used in production)

# --- Monitoring: Prometheus text at /metrics with "Authorization: Bearer <token>"; unset disables it ---
METRICS_TOKEN=

# --- Production compose only (the domain is set in deploy/api.caddy) ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Demo data (development only): password for every *@batraconnect.demo account created by npm run seed:demo
DEMO_PASSWORD=
